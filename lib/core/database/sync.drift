import 'tables.dart';

-- The change log used by the Wi-Fi sync. Every insert or update of a
-- shared row writes its table (entity) and row id here, one line per row:
-- a new change moves the line to the end with a new number (delete, then
-- insert: an "OR REPLACE" here would be overruled by an upsert). The hub
-- serves this log in order; a worker phone sends the lines it wrote.
CREATE TABLE sync_log (
  seq INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
  entity TEXT NOT NULL,
  row_id TEXT NOT NULL,
  UNIQUE (entity, row_id)
) AS SyncLogRow;


CREATE TRIGGER sync_log_shops_insert AFTER INSERT ON shops BEGIN
  DELETE FROM sync_log WHERE entity = 'shops' AND row_id = new.id;
  INSERT INTO sync_log (entity, row_id) VALUES ('shops', new.id);
END;

CREATE TRIGGER sync_log_shops_update AFTER UPDATE ON shops BEGIN
  DELETE FROM sync_log WHERE entity = 'shops' AND row_id = new.id;
  INSERT INTO sync_log (entity, row_id) VALUES ('shops', new.id);
END;

