CREATE TRIGGER sheet_credit_sales AFTER INSERT ON sales
  WHEN (SELECT sheet_url FROM shops WHERE deleted = 0 LIMIT 1) IS NOT NULL
    AND coalesce((SELECT value FROM app_settings WHERE "key" = 'sync_role'), '') <> 'worker'
    AND new.customer_id IS NOT NULL
BEGIN
  DELETE FROM sheet_queue WHERE kind = 'credit' AND row_id = new.customer_id;
  INSERT INTO sheet_queue (kind, row_id) VALUES ('credit', new.customer_id);
END;

CREATE TRIGGER sheet_credit_payments AFTER INSERT ON customer_payments
  WHEN (SELECT sheet_url FROM shops WHERE deleted = 0 LIMIT 1) IS NOT NULL
    AND coalesce((SELECT value FROM app_settings WHERE "key" = 'sync_role'), '') <> 'worker'
BEGIN
  DELETE FROM sheet_queue WHERE kind = 'credit' AND row_id = new.customer_id;
  INSERT INTO sheet_queue (kind, row_id) VALUES ('credit', new.customer_id);
END;

CREATE TRIGGER sheet_credit_returns AFTER INSERT ON returns
  WHEN (SELECT sheet_url FROM shops WHERE deleted = 0 LIMIT 1) IS NOT NULL
    AND coalesce((SELECT value FROM app_settings WHERE "key" = 'sync_role'), '') <> 'worker'
    AND new.refund_mode = 'credit'
    AND (SELECT customer_id FROM sales WHERE id = new.sale_id) IS NOT NULL
BEGIN
  DELETE FROM sheet_queue WHERE kind = 'credit' AND row_id = (SELECT customer_id FROM sales WHERE id = new.sale_id);
  INSERT INTO sheet_queue (kind, row_id) VALUES ('credit', (SELECT customer_id FROM sales WHERE id = new.sale_id));
END;

CREATE TRIGGER sheet_credit_customers AFTER UPDATE ON customers
  WHEN (SELECT sheet_url FROM shops WHERE deleted = 0 LIMIT 1) IS NOT NULL
    AND coalesce((SELECT value FROM app_settings WHERE "key" = 'sync_role'), '') <> 'worker'
BEGIN
  DELETE FROM sheet_queue WHERE kind = 'credit' AND row_id = new.id;
  INSERT INTO sheet_queue (kind, row_id) VALUES ('credit', new.id);
END;

-- Phase 8b: the history of product changes (names, prices...), and the
-- "Produits" tab (owner's phone only: it has the buying prices). A
-- product goes to the queue again when it changes or when its stock
-- moves (delivery, sale, loss, return).

CREATE TRIGGER sheet_changes_insert AFTER INSERT ON change_logs
  WHEN (SELECT sheet_url FROM shops WHERE deleted = 0 LIMIT 1) IS NOT NULL
    AND new.entity = 'product'
    AND (new.device_id = (SELECT value FROM app_settings WHERE "key" = 'device_id')
    OR coalesce((SELECT value FROM app_settings WHERE "key" = 'sync_role'), '') <> 'worker')
BEGIN
  DELETE FROM sheet_queue WHERE kind = 'change' AND row_id = new.id;
  INSERT INTO sheet_queue (kind, row_id) VALUES ('change', new.id);
END;

