CREATE TRIGGER sheet_product_deliveries_insert AFTER INSERT ON deliveries
  WHEN (SELECT sheet_url FROM shops WHERE deleted = 0 LIMIT 1) IS NOT NULL
    AND coalesce((SELECT value FROM app_settings WHERE "key" = 'sync_role'), '') <> 'worker'
BEGIN
  DELETE FROM sheet_queue WHERE kind = 'product' AND row_id = new.product_id;
  INSERT INTO sheet_queue (kind, row_id) VALUES ('product', new.product_id);
END;

CREATE TRIGGER sheet_product_deliveries_update AFTER UPDATE ON deliveries
